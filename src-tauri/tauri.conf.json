{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isolinear",
  "version": "0.1.0",
  "identifier": "io.github.mlaib.isolinear",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Isolinear",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Viewer and editor for structured text and data files",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Isolinear contributors",
    "copyright": "Isolinear contributors, Apache-2.0",
    "license": "Apache-2.0",
    "homepage": "https://github.com/mlaib/isolinear",
    "longDescription": "Read and edit Markdown, LaTeX, BibTeX, JSON, XML, YAML, TOML, CSV and source code; view data tables (Parquet, SQLite, Excel, Avro, HDF5), PDF, Word, notebooks, images and archives, and industry standards (ISO 20022, FHIR, EDIFACT, DICOM, IFC and more) read-only. Local only: nothing is fetched, nothing is run.",
    "fileAssociations": [
      {
        "name": "Markdown",
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "name": "JSON",
        "ext": [
          "json",
          "jsonl",
          "ndjson",
          "geojson"
        ],
        "mimeType": "application/json",
        "role": "Viewer"
      },
      {
        "name": "XML",
        "ext": [
          "xml",
          "xsd",
          "xsl",
          "svg",
          "plist"
        ],
        "mimeType": "application/xml",
        "role": "Viewer"
      },
      {
        "name": "YAML",
        "ext": [
          "yaml",
          "yml"
        ],
        "mimeType": "application/yaml",
        "role": "Viewer"
      },
      {
        "name": "TOML",
        "ext": [
          "toml"
        ],
        "mimeType": "application/toml",
        "role": "Viewer"
      },
      {
        "name": "CSV",
        "ext": [
          "csv",
          "tsv"
        ],
        "mimeType": "text/csv",
        "role": "Viewer"
      },
      {
        "name": "TeX",
        "ext": [
          "tex",
          "sty",
          "cls",
          "bib"
        ],
        "mimeType": "text/x-tex",
        "role": "Viewer"
      },
      {
        "name": "Jupyter notebook",
        "ext": [
          "ipynb"
        ],
        "mimeType": "application/x-ipynb+json",
        "role": "Viewer"
      },
      {
        "name": "Log",
        "ext": [
          "log"
        ],
        "mimeType": "text/x-log",
        "role": "Viewer"
      },
      {
        "name": "Parquet",
        "ext": [
          "parquet"
        ],
        "mimeType": "application/vnd.apache.parquet",
        "role": "Viewer"
      },
      {
        "name": "SQLite database",
        "ext": [
          "sqlite",
          "sqlite3",
          "db3"
        ],
        "mimeType": "application/vnd.sqlite3",
        "role": "Viewer"
      },
      {
        "name": "NumPy array",
        "ext": [
          "npy",
          "npz"
        ],
        "mimeType": "application/x-npy",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "../packaging/linux/isolinear.desktop",
        "files": {
          "/usr/share/mime/packages/isolinear.xml": "../packaging/linux/isolinear-mime.xml"
        }
      }
    }
  }
}
